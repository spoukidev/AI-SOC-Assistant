POSTGRES_DB=soc_xai
POSTGRES_USER=soc_xai
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql+psycopg://soc_xai:change-me-for-non-local-use@postgres:5432/soc_xai
BACKEND_CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
SEED_DEMO_DATA=true

# Authentication (required outside local demos; see README "Authentication").
# Leave empty to have the backend generate a random secret / one-time password at startup.
AUTH_SECRET_KEY=
ADMIN_USERNAME=admin
# Generate with: docker compose run --rm backend python -m app.auth hash-password
ADMIN_PASSWORD_HASH=
ACCESS_TOKEN_TTL_MINUTES=60
